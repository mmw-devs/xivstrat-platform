# GitHub App identifiers. Use the values from the installed GitHub App.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Local development: point to the GitHub App PEM file outside this repository.
GITHUB_APP_PRIVATE_KEY_PATH=

# Deployment alternative: inject the PEM content through the secret manager.
# GITHUB_APP_PRIVATE_KEY=

# Trusted server-side repository configuration.
GITHUB_OWNER=mmw-devs
GITHUB_REPO=xivstrat-platform
GITHUB_BASE_BRANCH=main

# Required only when deliberately running the manual GitHub write E2E.
CONFIRM_GITHUB_WRITE_E2E=
