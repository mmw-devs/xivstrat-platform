<section class="panel active" id="step1">
  <div class="help">必填项以<span class="required">*</span>标示；未完成的内容也可保存为草稿。</div>
  <div class="grid2">
    <div><label class="field-label" for="inp-title">副本标题<span class="required">*</span></label><input id="inp-title" placeholder="示例副本攻略" class="field-input" /></div>
    <div><label class="field-label" for="inp-name">副本英文名<span class="required">*</span></label><input id="inp-name" placeholder="零式如 m1s；其他为小写英文全名" class="field-input" /><div class="hint">极神、绝本及其他类型的空格自动替换为短横线。</div><div class="hint" id="name-warning" role="status"></div></div>
    <div><label class="field-label" for="inp-type">副本类型<span class="required">*</span></label><select id="inp-type" class="field-input"><option value="extreme">极神</option><option value="savage">零式</option><option value="ultimate">绝本</option><option value="other">其他</option></select></div>
    <div><label class="field-label" for="inp-banner">横幅图路径（可选）</label><input id="inp-banner" placeholder="banners/07/demo.webp" class="field-input" /></div>
    <div><label class="field-label" for="inp-video">视频链接（可选）</label><input id="inp-video" placeholder="https://www.bilibili.com/video/xxx" class="field-input" /></div>
    <div><label class="field-label" for="inp-status">内容状态</label><input id="inp-status" readonly value="draft" class="field-input" /></div>
    <div><label class="field-label" for="inp-date">最近保存／提交时间</label><input id="inp-date" readonly placeholder="保存或提交时自动记录" class="field-input" /></div>
  </div>
  <div class="mt-4"><button id="btn-step-1-next" class="btn primary">下一步：参考与宏 →</button></div>
</section>
