---
import EditorLayout from '../../layouts/EditorLayout.astro'
import MetadataStep from '../../components/editor/MetadataStep.astro'
import ReferencesStep from '../../components/editor/ReferencesStep.astro'
import AuthoringStep from '../../components/editor/AuthoringStep.astro'
import ProofreadStep from '../../components/editor/ProofreadStep.astro'
import PreviewStep from '../../components/editor/PreviewStep.astro'
---
<EditorLayout>
  <header class="editor-header">
    <h1>XivStrat 攻略编辑器 <span class="sub">可视化填写 · 实时预览 · 提交审核 · 无需编程</span></h1>
  </header>
  <nav class="steps" aria-label="编辑步骤">
    <button type="button" data-step="1" class="btn active" aria-current="step">① 基本信息</button>
    <button type="button" data-step="2" class="btn">② 参考与宏</button>
    <button type="button" data-step="3" class="btn">③ 阶段与机制</button>
    <button type="button" data-step="4" class="btn">④ 全文校对</button>
    <button type="button" data-step="5" class="btn">⑤ 预览 · 校验 · 提交</button>
  </nav>
  <main class="editor-main">
    <MetadataStep />
    <ReferencesStep />
    <AuthoringStep />
    <ProofreadStep />
    <PreviewStep />
  </main>
</EditorLayout>
<script>
  import { initEditor } from '../../scripts/editor'
  const root = document.getElementById('editor-app')
  if (root) initEditor(root)
</script>
